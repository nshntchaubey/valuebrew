<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 splash: same brand background and mark regardless of
     system dark/light mode — the splash is a deliberate brand moment, not
     themed UI chrome. Removed automatically once the Flutter engine draws
     its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
